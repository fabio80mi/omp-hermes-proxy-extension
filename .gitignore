node_modules/
dist/
.codegraph/
models.discovered.json
*.tmp

# API keys for the provider allowlist. Never commit.
.env
.env.*
!.env.example

# Audit output — regenerated by scripts/audit-models.mjs
audit.json

# Derived stability verdict, regenerated from the history on every audit run.
audit-stable.json

# Append-only audit history. Kept locally on purpose: it is the evidence behind
# every `verified-` name and grows without bound, so committing it would bloat
# the repo. Losing it silently resets stability to "no history", so back it up.
audit-history/

# Quality-eval output — regenerate with scripts/eval-models.mjs
eval-*.json

# Derived eval summary, regenerated from the history on every run.
eval-summary.json

# Append-only eval history, same reasoning as audit-history/: it grows without
# bound and losing it silently returns every model to "no data". Back it up.
eval-history/
