# API keys for the provider allowlist. Copy to .env and fill in.
# .env is git-ignored. Never commit real keys.
#
# Keys already in your shell environment win over this file, so you can also
# just export them instead of maintaining this file.

# Local Hermes proxy. The proxy ignores Authorization entirely, so this value
# is inert — any placeholder works.
HERMES_PROXY_KEY=Bearer HermesProxyLocal

# Cline Pass. Required for the cline-free/* models: without them the API answers
# 403 "only available via Cline product surfaces". Note that the SDK identity
# headers in providers.json are required as well; a key alone is not enough.
CLINE_API_KEY=

# Kilo gateway access token.
KILO_API_KEY=
